# انسخ هذا الملف إلى .env واملأ القيم، أو أضفها كمتغيرات بيئة (Environment Variables)
# في لوحة تحكم الاستضافة التي تختارها (Render / Railway / Fly.io ...).

# إلزامي: مفتاحك من console.anthropic.com (Account -> API Keys)
# هذا منفصل تمامًا عن اشتراك Claude.ai، ويُدفع حسب الاستخدام.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# اختياري: اسم النموذج المستخدم
ANTHROPIC_MODEL=claude-sonnet-5

# مستحسن بقوة: رمز سرّي من اختيارك. بدونه، أي شخص يعرف رابط موقعك
# يستطيع استخدام الأداة والتكلفة تُخصم من حسابك في Anthropic.
ACCESS_CODE=

# حد الطلبات لكل زائر في الساعة، لتقليل مخاطر إساءة الاستخدام
RATE_LIMIT_PER_HOUR=20

# المنفذ (تحدده الاستضافة غالبًا تلقائيًا عبر PORT، اتركه كما هو)
PORT=3000

# --- بيع الدومينات (Porkbun) ---
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
DOMAINS_ADMIN_TOKEN=
DOMAIN_MARKUP_SAR=25

# --- المحرك الخاص (ALLaM على RunPod) ---
SAUDI_ENGINE_URL=https://api.runpod.ai/v2/ENDPOINT_ID/openai/v1
SAUDI_ENGINE_KEY=
SAUDI_ENGINE_MODEL=ALLaM-AI/ALLaM-7B-Instruct-preview
